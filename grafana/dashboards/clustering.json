  "panels": [
    {
      "id": 1,
      "title": "Cluster Assignment per Carrier",
      "description": "K-Means clustering: assegnazione di ogni compagnia al proprio cluster. Chiave Redis: clustering:assignments",
      "type": "table",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "redis-datasource", "uid": "redis"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "thresholds"}, "custom": {"align": "auto"}},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "value"},
            "properties": [
              {"id": "displayName", "value": "Cluster"},
              {"id": "custom.width", "value": 80}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "field"},
            "properties": [{"id": "displayName", "value": "Carrier"}]
          }
        ]
      },
      "options": {"showHeader": true, "sortBy": [{"displayName": "Cluster", "desc": false}]},
      "targets": [
        {
          "datasource": {"type": "redis-datasource", "uid": "redis"},
          "refId": "A",
          "command": "hgetall",
          "keyName": "clustering:assignments"
        }
      ]
    },
    {
      "id": 2,
      "title": "Avg Departure Delay per Carrier (colorato per cluster)",
