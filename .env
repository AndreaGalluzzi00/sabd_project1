# === Piattaforma ===
# Su Mac M1: linux/amd64 (le immagini bde2020 non hanno build ARM nativa)
# Su EC2 x86_64: lasciamo lo stesso, è la piattaforma nativa
PLATFORM=linux/amd64

# === Versioni immagini (fissate per riproducibilità) ===
HADOOP_IMAGE_VERSION=2.0.0-hadoop3.2.1-java8

# === Cluster HDFS ===
CLUSTER_NAME=sabd-cluster

# === Spark ===
SPARK_IMAGE_VERSION=3.5.0
SPARK_IMAGE=apache/spark

# === NiFi ===
NIFI_IMAGE_VERSION=1.25.0
NIFI_USERNAME=admin
NIFI_PASSWORD=adminpassword123
